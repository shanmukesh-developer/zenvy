{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "1.0.0",
  "name": "Zenvy Unified Design System",
  "color": {
    "brand": {
      "primary": {
        "value": "#10B981",
        "type": "color",
        "description": "Zenvy Signature Emerald - fleet, primary CTA, trust"
      },
      "primaryLight": {
        "value": "#34D399",
        "type": "color",
        "description": "Light tint for emerald highlights and badges"
      },
      "primaryDark": {
        "value": "#059669",
        "type": "color",
        "description": "Dark emerald for pressed states"
      },
      "primaryMuted": {
        "value": "rgba(16, 185, 129, 0.15)",
        "type": "color",
        "description": "Subtle emerald background fill"
      },
      "gold": {
        "value": "#D4AF7A",
        "type": "color",
        "description": "Zenvy Luxury Metallic Gold - premium accents and highlights"
      },
      "goldLight": {
        "value": "#F0D9A8",
        "type": "color",
        "description": "Reflective light gold"
      },
      "goldMuted": {
        "value": "rgba(212, 175, 122, 0.15)",
        "type": "color",
        "description": "Subtle gold background fill"
      },
      "goldBorder": {
        "value": "rgba(212, 175, 122, 0.4)",
        "type": "color",
        "description": "Gold divider and border accent"
      },
      "accent": {
        "value": "#EF4F5F",
        "type": "color",
        "description": "Zenvy Coral - food, alerts, badges"
      },
      "accentMuted": {
        "value": "rgba(239, 79, 95, 0.15)",
        "type": "color",
        "description": "Subtle coral background fill"
      }
    },
    "state": {
      "success": {
        "value": "#10B981",
        "type": "color",
        "description": "Action succeeded, verified, or online"
      },
      "warning": {
        "value": "#F59E0B",
        "type": "color",
        "description": "Attention required or pending action"
      },
      "warningMuted": {
        "value": "rgba(245, 158, 11, 0.15)",
        "type": "color",
        "description": "Warning container fill"
      },
      "danger": {
        "value": "#EF4F5F",
        "type": "color",
        "description": "Destructive, cancelled, or error state"
      },
      "dangerMuted": {
        "value": "rgba(239, 79, 95, 0.15)",
        "type": "color",
        "description": "Error container fill"
      },
      "info": {
        "value": "#3B82F6",
        "type": "color",
        "description": "Information, offers, or guidance"
      },
      "infoMuted": {
        "value": "rgba(59, 130, 246, 0.15)",
        "type": "color",
        "description": "Info container fill"
      }
    },
    "theme": {
      "dark": {
        "surface": {
          "canvas": { "value": "#09090B", "type": "color", "description": "Core obsidian background" },
          "subtle": { "value": "#121215", "type": "color", "description": "Secondary surface background" },
          "card": { "value": "#18181B", "type": "color", "description": "Standard card background" },
          "cardElevated": { "value": "#222226", "type": "color", "description": "Elevated modal and popover surface" },
          "cardHover": { "value": "#27272A", "type": "color", "description": "Hovered or active card state" },
          "input": { "value": "rgba(255, 255, 255, 0.05)", "type": "color", "description": "Form input background" },
          "tabBar": { "value": "#0D0D10", "type": "color", "description": "Bottom navigation surface" },
          "glass": { "value": "rgba(24, 24, 27, 0.92)", "type": "color", "description": "Translucent frosted glass" }
        },
        "text": {
          "primary": { "value": "#FFFFFF", "type": "color", "description": "Primary high-contrast text" },
          "secondary": { "value": "#A1A1AA", "type": "color", "description": "Secondary supporting text" },
          "muted": { "value": "#8B8B93", "type": "color", "description": "Muted captions and labels (WCAG 4.63:1 on cardElevated)" },
          "disabled": { "value": "#52525B", "type": "color", "description": "Disabled interactive text" }
        },
        "border": {
          "subtle": { "value": "rgba(255, 255, 255, 0.04)", "type": "color", "description": "Hairline separator" },
          "standard": { "value": "rgba(255, 255, 255, 0.08)", "type": "color", "description": "Card and container border" },
          "active": { "value": "rgba(255, 255, 255, 0.16)", "type": "color", "description": "Focused or selected border" }
        }
      },
      "light": {
        "surface": {
          "canvas": { "value": "#F8F9FA", "type": "color", "description": "Core light background" },
          "subtle": { "value": "#F1F3F5", "type": "color", "description": "Secondary surface background" },
          "card": { "value": "#FFFFFF", "type": "color", "description": "Standard card background" },
          "cardElevated": { "value": "#F8F9FB", "type": "color", "description": "Elevated modal and popover surface" },
          "cardHover": { "value": "#F1F3F9", "type": "color", "description": "Hovered card surface" },
          "input": { "value": "#F1F4F8", "type": "color", "description": "Form input background" },
          "tabBar": { "value": "#FFFFFF", "type": "color", "description": "Bottom navigation surface" },
          "glass": { "value": "rgba(255, 255, 255, 0.92)", "type": "color", "description": "Translucent frosted glass" }
        },
        "text": {
          "primary": { "value": "#0F172A", "type": "color", "description": "Primary high-contrast text" },
          "secondary": { "value": "#475569", "type": "color", "description": "Secondary supporting text" },
          "muted": { "value": "#617088", "type": "color", "description": "Muted captions and labels (WCAG 4.76:1 on canvas)" },
          "disabled": { "value": "#CBD5E1", "type": "color", "description": "Disabled interactive text" }
        },
        "border": {
          "subtle": { "value": "rgba(0, 0, 0, 0.04)", "type": "color", "description": "Hairline separator" },
          "standard": { "value": "rgba(0, 0, 0, 0.08)", "type": "color", "description": "Card and container border" },
          "active": { "value": "rgba(0, 0, 0, 0.16)", "type": "color", "description": "Focused or selected border" }
        }
      }
    }
  }
}
