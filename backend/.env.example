PORT=8080
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=*

# Database (PostgreSQL for production, SQLite used in local dev if omitted)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# MONGO_URI=mongodb+srv://...

# Firebase Admin SDK (for push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Process role (jobs/index.js, utils/processRole.js)
# all (default) = API + sockets + scheduled jobs | web = API + sockets only | worker = jobs + health only
# (worker has no socket server: job socket emits are dropped with a warning until the Redis emitter, Phase 2)
# PROCESS_ROLE=all
# KEEPALIVE=false        # turn off the production self-ping (only useful on Render free)
# JOBS_DEBUG=1           # print skipped job ticks and idle runs (debug level)
